---
/** Spanish landing page. Full page mirroring is tracked in bead #23. */
import Base from '../../layouts/Base.astro';
import {useTranslations, href} from '../../i18n/utils';

const t = useTranslations('es');
---

<Base>
  <h1>{t('site.title')}</h1>
  <p>{t('site.tagline')}</p>
  <p>
    <a href={href('downloads', 'es')}>{t('home.cta')}</a>
  </p>
</Base>
