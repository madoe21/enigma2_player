---
/**
 * Pricing island: fetches the app's ACTIVE license models from the license
 * server at runtime (GET /pricing/:apiKey) and renders the tiers. Prices are
 * never hardcoded — they come from the admin-configured models. Degrades to a
 * friendly "coming soon" message when the API is unset/unreachable/empty.
 *
 * Config comes from PUBLIC_* env (no secrets); see .env.example.
 */
import {useTranslations, href} from '../i18n/utils';
import type {Lang} from '../i18n/ui';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const t = useTranslations(lang);

const config = {
  lang,
  buyBase: href('buy', lang),
  labels: {
    devices: t('pricing.devices'),
    cta: t('pricing.cta'),
    empty: t('pricing.empty'),
    period: {
      monthly: t('pricing.period.monthly'),
      yearly: t('pricing.period.yearly'),
      lifetime: t('pricing.period.lifetime'),
    },
  },
};
---

<h1>{t('nav.pricing')}</h1>
<p>{t('pricing.intro')}</p>

<div id="pricing-list" class="grid" data-loading>{t('pricing.loading')}</div>
<script
  type="application/json"
  id="pricing-config"
  is:inline
  set:html={JSON.stringify(config)}
/>

<script>
  interface Model {
    id: string;
    display_name: string;
    device_count: number;
    period: 'monthly' | 'yearly' | 'lifetime';
    price: number;
    currency: string;
  }
  interface Pricing {
    applicationId: string;
    models: Model[];
  }
  interface Cfg {
    lang: string;
    buyBase: string;
    labels: {
      devices: string;
      cta: string;
      empty: string;
      period: Record<Model['period'], string>;
    };
  }

  const cfgEl = document.getElementById('pricing-config');
  const list = document.getElementById('pricing-list');
  const cfg: Cfg = JSON.parse(cfgEl?.textContent ?? '{}');
  const base = import.meta.env.PUBLIC_LICENSE_API_BASE;
  const apiKey = import.meta.env.PUBLIC_APP_API_KEY;

  function showEmpty() {
    if (list) {
      list.removeAttribute('data-loading');
      list.textContent = cfg.labels.empty;
    }
  }

  function money(value: number, currency: string): string {
    try {
      return new Intl.NumberFormat(cfg.lang, {
        style: 'currency',
        currency,
      }).format(value);
    } catch {
      return `${value} ${currency}`;
    }
  }

  async function load() {
    if (!base || !apiKey || apiKey.includes('REPLACE_ME') || !list) {
      return showEmpty();
    }
    try {
      const res = await fetch(`${base}/pricing/${apiKey}`);
      if (!res.ok) return showEmpty();
      const data: Pricing = await res.json();
      if (!data.models?.length) return showEmpty();

      list.removeAttribute('data-loading');
      list.textContent = '';
      for (const m of data.models) {
        const card = document.createElement('article');
        card.className = 'tier';
        const period = cfg.labels.period[m.period] ?? '';
        const buy = `${cfg.buyBase}?model=${encodeURIComponent(m.id)}`;
        card.innerHTML =
          `<h2></h2>` +
          `<p class="devices"></p>` +
          `<p class="price"><strong></strong> <span class="per"></span></p>` +
          `<a class="btn"></a>`;
        card.querySelector('h2')!.textContent = m.display_name;
        card.querySelector('.devices')!.textContent =
          `${m.device_count} ${cfg.labels.devices}`;
        card.querySelector('.price strong')!.textContent = money(
          m.price,
          m.currency
        );
        card.querySelector('.per')!.textContent = period;
        const a = card.querySelector('a')!;
        a.textContent = cfg.labels.cta;
        a.setAttribute('href', buy);
        list.appendChild(card);
      }
    } catch {
      showEmpty();
    }
  }

  load();
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .tier {
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tier h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .tier .devices {
    margin: 0;
    color: #6b7280;
  }
  .tier .price {
    margin: 0.25rem 0 0.75rem;
    font-size: 1.4rem;
  }
  .tier .per {
    font-size: 0.95rem;
    color: #6b7280;
  }
  .tier .btn {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: #2563eb;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
</style>
