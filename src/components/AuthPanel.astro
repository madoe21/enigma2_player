---
/**
 * Account auth panel (#14): sign in / sign up / forgot-password forms and the
 * signed-in view. Talks to the license server via src/lib/licenseApi (in-memory
 * session, #13). Degrades to a "backend not connected" note when the API base
 * is unset.
 */
import {useTranslations} from '../i18n/utils';
import type {Lang} from '../i18n/ui';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const t = useTranslations(lang);

const messages = {
  error: t('auth.error'),
  registerDone: t('auth.register.done'),
  resetDone: t('auth.reset.done'),
  loggedInAs: t('auth.loggedInAs'),
  emptyLicenses: t('account.empty.licenses'),
  emptyDevices: t('account.empty.devices'),
  emptyInvoices: t('account.empty.invoices'),
  deviceRemove: t('account.device.remove'),
  invoiceDownload: t('account.invoice.download'),
  passwordDone: t('account.password.done'),
  changeLabel: t('account.change.label'),
  changeSubmit: t('account.change.submit'),
};
---

<div id="auth">
  <p id="auth-unconfigured" class="note" hidden>{t('auth.notConfigured')}</p>

  <div id="auth-signedin" hidden>
    <p>
      {t('auth.loggedInAs')} <strong id="auth-email"></strong>
      <button id="auth-logout" class="btn">{t('auth.logout')}</button>
    </p>

    <section class="dash">
      <h2>{t('account.licenses.title')}</h2>
      <div id="dash-licenses" class="rows"></div>

      <h2>{t('account.devices.title')}</h2>
      <div id="dash-devices" class="rows"></div>

      <h2>{t('account.invoices.title')}</h2>
      <div id="dash-invoices" class="rows"></div>

      <h2>{t('account.password.title')}</h2>
      <form id="pw-form" class="form">
        <label>{t('account.password.current')}<input name="currentPassword" type="password" required autocomplete="current-password" /></label>
        <label>{t('account.password.new')}<input name="newPassword" type="password" required autocomplete="new-password" minlength="10" /></label>
        <button class="btn primary" type="submit">{t('account.password.submit')}</button>
        <p id="pw-msg" role="status" aria-live="polite"></p>
      </form>

      <h2 class="danger-h">{t('account.delete.title')}</h2>
      <p class="note">{t('account.delete.warn')}</p>
      <form id="del-form" class="form">
        <label>{t('account.delete.confirm')}<input name="confirm" autocomplete="off" /></label>
        <button class="btn danger" type="submit">{t('account.delete.button')}</button>
        <p id="del-msg" role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>

  <div id="auth-forms">
    <div class="tabs" role="tablist">
      <button class="tab" data-tab="login" aria-selected="true">{t('auth.tab.login')}</button>
      <button class="tab" data-tab="register">{t('auth.tab.register')}</button>
      <button class="tab" data-tab="forgot">{t('auth.tab.forgot')}</button>
    </div>

    <form data-form="login" class="form">
      <label>{t('auth.email')}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{t('auth.password')}<input name="password" type="password" required autocomplete="current-password" /></label>
      <button class="btn primary" type="submit">{t('auth.submit.login')}</button>
    </form>

    <form data-form="register" class="form" hidden>
      <label>{t('auth.firstName')}<input name="firstName" type="text" autocomplete="given-name" /></label>
      <label>{t('auth.lastName')}<input name="lastName" type="text" autocomplete="family-name" /></label>
      <label>{t('auth.email')}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{t('auth.password')}<input name="password" type="password" required autocomplete="new-password" minlength="10" /></label>
      <button class="btn primary" type="submit">{t('auth.submit.register')}</button>
    </form>

    <form data-form="forgot" class="form" hidden>
      <label>{t('auth.email')}<input name="email" type="email" required autocomplete="email" /></label>
      <p class="note">{t('auth.forgot.hint')}</p>
      <button class="btn primary" type="submit">{t('auth.submit.forgot')}</button>
    </form>

    <p id="auth-msg" role="status" aria-live="polite"></p>
  </div>
</div>

<script
  type="application/json"
  id="auth-i18n"
  is:inline
  set:html={JSON.stringify(messages)}
/>

<script>
  import {
    login,
    register,
    requestPasswordReset,
    logout,
    currentUser,
    isConfigured,
    onAuthChange,
    ApiError,
    getLicenses,
    getDevices,
    removeDevice,
    getInvoices,
    invoiceDownloadUrl,
    changePassword,
    deleteAccount,
    getPricing,
    isPurchaseReady,
    changeSubscription,
    type License,
    type Device,
    type Invoice,
    type PricingModel,
  } from '../lib/licenseApi';

  const msgs = JSON.parse(
    document.getElementById('auth-i18n')?.textContent ?? '{}'
  );
  const root = document.getElementById('auth');
  const signedIn = document.getElementById('auth-signedin');
  const forms = document.getElementById('auth-forms');
  const unconfigured = document.getElementById('auth-unconfigured');
  const emailOut = document.getElementById('auth-email');
  const msg = document.getElementById('auth-msg');

  function setMsg(text: string, kind: 'error' | 'ok' | '' = ''): void {
    if (!msg) return;
    msg.textContent = text;
    msg.dataset.kind = kind;
  }

  let loadedFor: string | null = null;

  function render(): void {
    if (!root) return;
    const configured = isConfigured();
    unconfigured!.hidden = configured;
    const user = currentUser();
    signedIn!.hidden = !user;
    forms!.hidden = !!user || !configured;
    if (user && emailOut) emailOut.textContent = user.email;
    if (user && loadedFor !== user.email) {
      loadedFor = user.email;
      loadDashboard();
    }
    if (!user) loadedFor = null;
  }

  function esc(s: unknown): string {
    return String(s ?? '').replace(
      /[&<>"]/g,
      c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'})[c]!
    );
  }

  function money(v: number, currency: string): string {
    try {
      return new Intl.NumberFormat(undefined, {style: 'currency', currency}).format(v);
    } catch {
      return `${v} ${currency}`;
    }
  }

  async function loadDashboard(): Promise<void> {
    const licEl = document.getElementById('dash-licenses');
    const devEl = document.getElementById('dash-devices');
    const invEl = document.getElementById('dash-invoices');

    // Models for the "switch model" control (#18), if purchasing is configured.
    let models: PricingModel[] = [];
    if (isPurchaseReady()) {
      try {
        models = (await getPricing()).models;
      } catch {
        models = [];
      }
    }
    const modelOptions = models
      .map(m => `<option value="${esc(m.id)}">${esc(m.display_name)}</option>`)
      .join('');

    try {
      const licenses = await getLicenses();
      if (licEl)
        licEl.innerHTML = licenses.length
          ? licenses
              .map((l: License) => {
                const head =
                  `<div class="row"><span>${esc(l.model?.display_name ?? l.application?.name ?? '—')}</span>` +
                  `<span class="muted">${esc(l.status)}${l.period_end ? ' · ' + esc(l.period_end.slice(0, 10)) : ''}</span></div>`;
                const change =
                  models.length && l.status === 'active'
                    ? `<div class="change"><label>${esc(msgs.changeLabel)} ` +
                      `<select data-change-model="${esc(l.id)}">${modelOptions}</select></label>` +
                      `<button class="btn small" data-change="${esc(l.id)}">${esc(msgs.changeSubmit)}</button></div>`
                    : '';
                return head + change;
              })
              .join('')
          : `<p class="muted">${esc(msgs.emptyLicenses)}</p>`;

      licEl?.querySelectorAll<HTMLButtonElement>('[data-change]').forEach(b =>
        b.addEventListener('click', async () => {
          const sel = licEl.querySelector<HTMLSelectElement>(
            `[data-change-model="${b.dataset.change}"]`
          );
          if (!sel) return;
          b.disabled = true;
          try {
            const {approveUrl} = await changeSubscription(
              b.dataset.change!,
              sel.value
            );
            if (approveUrl) window.location.href = approveUrl;
            else await loadDashboard();
          } catch {
            b.disabled = false;
          }
        })
      );
    } catch {
      if (licEl) licEl.innerHTML = `<p class="muted">${esc(msgs.emptyLicenses)}</p>`;
    }

    async function refreshDevices(): Promise<void> {
      try {
        const devices = await getDevices();
        if (!devEl) return;
        if (!devices.length) {
          devEl.innerHTML = `<p class="muted">${esc(msgs.emptyDevices)}</p>`;
          return;
        }
        devEl.innerHTML = devices
          .map(
            (d: Device) =>
              `<div class="row"><span>${esc(d.name || d.device_id)}</span>` +
              `<span class="muted">${esc(d.os ?? '')}</span>` +
              `<button class="btn small" data-remove="${esc(d.id)}">${esc(msgs.deviceRemove)}</button></div>`
          )
          .join('');
        devEl.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(b =>
          b.addEventListener('click', async () => {
            b.disabled = true;
            try {
              await removeDevice(b.dataset.remove!);
              await refreshDevices();
            } catch {
              b.disabled = false;
            }
          })
        );
      } catch {
        if (devEl) devEl.innerHTML = `<p class="muted">${esc(msgs.emptyDevices)}</p>`;
      }
    }
    await refreshDevices();

    try {
      const invoices = await getInvoices();
      if (invEl)
        invEl.innerHTML = invoices.length
          ? invoices
              .map(
                (i: Invoice) =>
                  `<div class="row"><span>${esc(i.number)}</span>` +
                  `<span class="muted">${money(i.gross, i.currency)} · ${esc(i.issued_at.slice(0, 10))}</span>` +
                  `<button class="btn small" data-invoice="${esc(i.id)}">${esc(msgs.invoiceDownload)}</button></div>`
              )
              .join('')
          : `<p class="muted">${esc(msgs.emptyInvoices)}</p>`;
      invEl?.querySelectorAll<HTMLButtonElement>('[data-invoice]').forEach(b =>
        b.addEventListener('click', async () => {
          try {
            const {url} = await invoiceDownloadUrl(b.dataset.invoice!);
            window.open(url, '_blank', 'noopener');
          } catch {
            /* ignore */
          }
        })
      );
    } catch {
      if (invEl) invEl.innerHTML = `<p class="muted">${esc(msgs.emptyInvoices)}</p>`;
    }
  }

  document.getElementById('pw-form')?.addEventListener('submit', e => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    const d = fields(f);
    const out = document.getElementById('pw-msg')!;
    const btn = f.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    out.textContent = '';
    changePassword(d.currentPassword, d.newPassword)
      .then(() => {
        out.textContent = msgs.passwordDone;
        out.dataset.kind = 'ok';
        f.reset();
      })
      .catch((err: unknown) => {
        out.textContent = err instanceof ApiError ? err.message : msgs.error;
        out.dataset.kind = 'error';
      })
      .finally(() => (btn.disabled = false));
  });

  document.getElementById('del-form')?.addEventListener('submit', e => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    const d = fields(f);
    const out = document.getElementById('del-msg')!;
    if (d.confirm !== 'DELETE') {
      out.textContent = 'DELETE';
      out.dataset.kind = 'error';
      return;
    }
    const btn = f.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    deleteAccount().catch((err: unknown) => {
      out.textContent = err instanceof ApiError ? err.message : msgs.error;
      out.dataset.kind = 'error';
      btn.disabled = false;
    });
  });

  function selectTab(name: string): void {
    document.querySelectorAll<HTMLElement>('.tab').forEach(b => {
      b.setAttribute('aria-selected', String(b.dataset.tab === name));
    });
    document.querySelectorAll<HTMLElement>('[data-form]').forEach(f => {
      f.hidden = f.dataset.form !== name;
    });
    setMsg('');
  }

  document.querySelectorAll<HTMLElement>('.tab').forEach(b => {
    b.addEventListener('click', () => selectTab(b.dataset.tab!));
  });

  function fields(form: HTMLFormElement): Record<string, string> {
    const data: Record<string, string> = {};
    new FormData(form).forEach((v, k) => (data[k] = String(v)));
    return data;
  }

  async function submit(
    form: HTMLFormElement,
    fn: () => Promise<void>
  ): Promise<void> {
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    setMsg('');
    try {
      await fn();
    } catch (e) {
      setMsg(e instanceof ApiError ? e.message : msgs.error, 'error');
    } finally {
      btn.disabled = false;
    }
  }

  document
    .querySelector<HTMLFormElement>('[data-form=login]')!
    .addEventListener('submit', e => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const d = fields(f);
      submit(f, () => login(d.email, d.password));
    });

  document
    .querySelector<HTMLFormElement>('[data-form=register]')!
    .addEventListener('submit', e => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const d = fields(f);
      submit(f, async () => {
        await register({
          email: d.email,
          password: d.password,
          firstName: d.firstName || undefined,
          lastName: d.lastName || undefined,
        });
        setMsg(msgs.registerDone, 'ok');
        f.reset();
      });
    });

  document
    .querySelector<HTMLFormElement>('[data-form=forgot]')!
    .addEventListener('submit', e => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const d = fields(f);
      submit(f, async () => {
        await requestPasswordReset(d.email);
        setMsg(msgs.resetDone, 'ok');
        f.reset();
      });
    });

  document
    .getElementById('auth-logout')!
    .addEventListener('click', () => logout());

  onAuthChange(render);
  render();
</script>

<style>
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin: 1.5rem 0 1rem;
    flex-wrap: wrap;
  }
  .tab {
    padding: 0.4rem 0.9rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: transparent;
    cursor: pointer;
  }
  .tab[aria-selected='true'] {
    border-color: #2563eb;
    color: #2563eb;
    font-weight: 600;
  }
  .form {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
  }
  .form label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.95rem;
  }
  .form input {
    padding: 0.5rem 0.6rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.4rem;
    font: inherit;
  }
  .btn {
    padding: 0.55rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #2563eb;
    background: transparent;
    color: #2563eb;
    font-weight: 600;
    cursor: pointer;
  }
  .btn.primary {
    background: #2563eb;
    color: #fff;
    justify-self: start;
  }
  .note {
    color: #6b7280;
    font-size: 0.95rem;
  }
  #auth-msg[data-kind='error'],
  [role='status'][data-kind='error'] {
    color: #b91c1c;
  }
  #auth-msg[data-kind='ok'],
  [role='status'][data-kind='ok'] {
    color: #15803d;
  }
  .dash {
    margin-top: 1rem;
  }
  .dash h2 {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.5rem;
  }
  .rows {
    display: grid;
    gap: 0.5rem;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
  }
  .row > span:first-child {
    font-weight: 600;
  }
  .muted {
    color: #6b7280;
  }
  .row .btn {
    margin-left: auto;
  }
  .btn.small {
    padding: 0.3rem 0.7rem;
    font-size: 0.9rem;
  }
  .btn.danger {
    border-color: #b91c1c;
    color: #b91c1c;
    justify-self: start;
  }
  .danger-h {
    color: #b91c1c;
  }
  .change {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0 0.75rem;
    font-size: 0.95rem;
  }
  .change select {
    padding: 0.35rem 0.5rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.4rem;
    font: inherit;
  }
</style>
