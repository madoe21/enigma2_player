---
/**
 * Embeds the license server's per-application shop/account page (ADR-0005
 * in the license_server repo, bead enigma2_player_page-9ou). Purchase,
 * login and account management are implemented THERE — this site only
 * frames it. The server must allow this origin via EMBED_ALLOWED_ORIGINS.
 */
import {getLangFromUrl} from '../i18n/utils';

const base = import.meta.env.PUBLIC_LICENSE_API_BASE;
const apiKey = import.meta.env.PUBLIC_APP_API_KEY;
// Pass the page's locale into the shop so it renders in the same language.
// Through the shared helper, not a fourth copy of the language list: this
// read its own `['en', 'es', 'fr', 'it']` and took the locale from
// `segments[1]`, which assumes a base path is always present. Deployed it
// was, so this one worked in production and silently sold in German locally -
// the exact mirror of the bug in `getLangFromUrl` (enigma2_player-w83).
const lang = getLangFromUrl(Astro.url);
const src =
  base && apiKey ? `${base}/shop/${apiKey}?lang=${lang}` : null;
---

{
  src ? (
    <>
      <iframe
        src={src}
        class="shop-frame"
        title="Shop & Konto"
        loading="lazy"
      />
      <p class="shop-fallback">
        <a href={src} target="_blank" rel="noopener">
          Shop in neuem Tab öffnen ↗
        </a>
      </p>
    </>
  ) : (
    <p>Der Shop ist noch nicht verfügbar — bald mehr.</p>
  )
}

<style>
  .shop-frame {
    width: 100%;
    min-height: 920px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
  }
  .shop-fallback {
    text-align: right;
    font-size: 0.85rem;
  }
</style>
