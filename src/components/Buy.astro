---
/**
 * Buy flow (#12): pick an active model, sign in (in-page, since the session is
 * in-memory and per page), then start a server-side PayPal checkout and redirect
 * to the approve URL. Activation happens server-side (subscription webhook /
 * order capture) — the browser only redirects. No secrets in the browser.
 */
import {useTranslations} from '../i18n/utils';
import type {Lang} from '../i18n/ui';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const t = useTranslations(lang);

const labels = {
  empty: t('buy.empty'),
  select: t('buy.select'),
  selected: t('buy.selected'),
  loginFirst: t('buy.loginFirst'),
  checkout: t('buy.checkout'),
  processing: t('buy.processing'),
  notConfigured: t('auth.notConfigured'),
  error: t('auth.error'),
  devices: t('pricing.devices'),
  period: {
    monthly: t('pricing.period.monthly'),
    yearly: t('pricing.period.yearly'),
    lifetime: t('pricing.period.lifetime'),
  },
};
---

<h1>{t('nav.buy')}</h1>
<p>{t('buy.intro')}</p>

<p id="buy-unconfigured" class="note" hidden>{t('auth.notConfigured')}</p>
<div id="buy-models" class="rows">{t('buy.loading')}</div>

<div id="buy-login" hidden>
  <p class="note">{t('buy.loginFirst')}</p>
  <form id="buy-login-form" class="form">
    <label>{t('auth.email')}<input name="email" type="email" required autocomplete="email" /></label>
    <label>{t('auth.password')}<input name="password" type="password" required autocomplete="current-password" /></label>
    <button class="btn" type="submit">{t('auth.submit.login')}</button>
  </form>
</div>

<button id="buy-checkout" class="btn primary" hidden>{t('buy.checkout')}</button>
<p id="buy-msg" role="status" aria-live="polite"></p>

<script
  type="application/json"
  id="buy-labels"
  is:inline
  set:html={JSON.stringify(labels)}
/>

<script>
  import {
    getPricing,
    startCheckout,
    login,
    currentUser,
    isPurchaseReady,
    ApiError,
    type PricingModel,
  } from '../lib/licenseApi';

  const L = JSON.parse(document.getElementById('buy-labels')!.textContent!);
  const modelsEl = document.getElementById('buy-models')!;
  const loginEl = document.getElementById('buy-login')!;
  const checkoutBtn = document.getElementById('buy-checkout') as HTMLButtonElement;
  const msg = document.getElementById('buy-msg')!;
  const unconfigured = document.getElementById('buy-unconfigured')!;

  let applicationId = '';
  let models: PricingModel[] = [];
  let selected: PricingModel | null = null;

  function esc(s: unknown): string {
    return String(s ?? '').replace(
      /[&<>"]/g,
      c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'})[c]!
    );
  }
  function money(v: number, currency: string): string {
    try {
      return new Intl.NumberFormat(undefined, {style: 'currency', currency}).format(v);
    } catch {
      return `${v} ${currency}`;
    }
  }
  function setMsg(text: string, kind = ''): void {
    msg.textContent = text;
    msg.dataset.kind = kind;
  }

  function renderModels(): void {
    modelsEl.innerHTML = models
      .map(m => {
        const on = selected?.id === m.id;
        return (
          `<div class="row${on ? ' on' : ''}"><span>${esc(m.display_name)}</span>` +
          `<span class="muted">${m.device_count} ${esc(L.devices)} · ${money(m.price, m.currency)} ${esc(L.period[m.period] ?? '')}</span>` +
          `<button class="btn small" data-pick="${esc(m.id)}">${on ? esc(L.selected) : esc(L.select)}</button></div>`
        );
      })
      .join('');
    modelsEl.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach(b =>
      b.addEventListener('click', () => {
        selected = models.find(m => m.id === b.dataset.pick) ?? null;
        renderModels();
        renderState();
      })
    );
  }

  function renderState(): void {
    const user = currentUser();
    loginEl.hidden = !selected || !!user;
    checkoutBtn.hidden = !selected || !user;
    setMsg('');
  }

  async function checkout(): Promise<void> {
    if (!selected) return;
    checkoutBtn.disabled = true;
    setMsg(L.processing);
    const here = window.location.href.split('?')[0];
    try {
      const {approveUrl} = await startCheckout(
        applicationId,
        selected,
        `${here}?status=return`,
        `${here}?status=cancel`
      );
      window.location.href = approveUrl;
    } catch (e) {
      setMsg(e instanceof ApiError ? e.message : L.error, 'error');
      checkoutBtn.disabled = false;
    }
  }

  document
    .getElementById('buy-login-form')!
    .addEventListener('submit', async e => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const d: Record<string, string> = {};
      new FormData(f).forEach((v, k) => (d[k] = String(v)));
      const btn = f.querySelector('button') as HTMLButtonElement;
      btn.disabled = true;
      setMsg('');
      try {
        await login(d.email, d.password);
        renderState();
      } catch (err) {
        setMsg(err instanceof ApiError ? err.message : L.error, 'error');
      } finally {
        btn.disabled = false;
      }
    });

  checkoutBtn.addEventListener('click', checkout);

  async function init(): Promise<void> {
    if (!isPurchaseReady()) {
      unconfigured.hidden = false;
      modelsEl.hidden = true;
      return;
    }
    try {
      const data = await getPricing();
      applicationId = data.applicationId;
      models = data.models;
      if (!models.length) {
        modelsEl.textContent = L.empty;
        return;
      }
      const pre = new URLSearchParams(window.location.search).get('model');
      if (pre) selected = models.find(m => m.id === pre) ?? null;
      renderModels();
      renderState();
    } catch {
      modelsEl.textContent = L.empty;
    }
  }

  init();
</script>

<style>
  .rows {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0;
    max-width: 34rem;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
  }
  .row.on {
    border-color: #2563eb;
    background: #eff6ff;
  }
  .row > span:first-child {
    font-weight: 600;
  }
  .row .btn {
    margin-left: auto;
  }
  .muted {
    color: #6b7280;
  }
  .form {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
    margin: 1rem 0;
  }
  .form label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.95rem;
  }
  .form input {
    padding: 0.5rem 0.6rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.4rem;
    font: inherit;
  }
  .btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #2563eb;
    background: transparent;
    color: #2563eb;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }
  .btn.primary {
    background: #2563eb;
    color: #fff;
  }
  .btn.small {
    padding: 0.35rem 0.8rem;
    font-size: 0.9rem;
  }
  .note {
    color: #6b7280;
  }
  #buy-msg[data-kind='error'] {
    color: #b91c1c;
  }
</style>
