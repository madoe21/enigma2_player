---
/** Screenshots gallery — real product images from public/screenshots/ (#5). */
import {useTranslations, asset} from '../i18n/utils';
import {getScreenshots} from '../i18n/content';
import type {Lang} from '../i18n/ui';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const t = useTranslations(lang);
const shots = getScreenshots(lang);
---

<h1>{t('nav.screenshots')}</h1>
<p>{t('screenshots.note')}</p>
<div class="grid">
  {
    shots.map(s => (
      <figure class="tile">
        <a href={asset(`screenshots/${s.file}`)} target="_blank" rel="noopener">
          <img
            src={asset(`screenshots/${s.file}`)}
            alt={s.caption}
            loading="lazy"
            width="1200"
          />
        </a>
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .tile {
    margin: 0;
  }
  .tile img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 0.6rem;
    background: #fff;
  }
  figcaption {
    margin-top: 0.4rem;
    color: #4b5563;
    font-size: 0.95rem;
  }
</style>
