# Public product-page config (safe in the browser — NO secrets here).
# Copy to .env (git-ignored). Only PUBLIC_* vars are exposed to client code.

# Base URL of the license server API (Render). No trailing slash.
PUBLIC_LICENSE_API_BASE=https://license-server-dev.onrender.com

# The product's application api_key (public identifier) used for the pricing
# list and portal calls. NOT a secret — the api_key is public per design.
PUBLIC_APP_API_KEY=app_REPLACE_ME
