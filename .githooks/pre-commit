#!/usr/bin/env bash
# Enforce Google-style format + lint + unit tests before a commit.
# Emergency bypass (discouraged): AIFLOW_SKIP_VERIFY=1 git commit ...
[ "${AIFLOW_SKIP_VERIFY:-}" = "1" ] && exit 0
set -uo pipefail
have() { command -v "$1" >/dev/null 2>&1; }
fail() { echo "✗ pre-commit: $1" >&2; exit 1; }

echo "• pre-commit: format + lint + tests"

# This hook judges the STAGED content, not the working tree (aiflow-5n9): a file you staged and
# then broke locally must not commit green, and a fix you staged must not be blocked by the mess
# still in your worktree. Two mechanics do that without `git stash --keep-index`, which needs a
# `git reset --hard` to be safe around the formatter below and can lose work if the hook dies:
# formatting skips any file with unstaged changes, and the roster guard runs against a temp
# checkout of the index. Deliberate exception: the stack lint/tests in step 4 still run against
# the worktree — they need the installed toolchain (node_modules, venv, build cache) that a
# temp checkout does not have.

# Prettier gets resolved, not just looked up: unlike the other formatters below it is pinned
# EXACTLY by this repository (3.9.10, no caret, in both package.json files) and CI checks with
# that version as a hard gate (enigma2_player-63s). A `prettier` from PATH is a different and
# unknowable version, and a formatter patch release can change its output - the commit then looks
# right locally and fails CI with a diff its author never wrote. So the project-local binary
# decides what correct looks like, and when there is none the hook SAYS so: the old test was
# `have prettier`, which is plainly false on a machine with no global install, so this step
# formatted nothing and mentioned nothing, and only CI ever brought it up (enigma2_player-38r).
# Resolved once rather than per file - both branches cost Node startup, and the loop below runs
# once per staged file. Which config applies is still prettier's own decision: it reads the
# `.prettierrc` and `.prettierignore` nearest the file, so a file under `site/` is formatted by
# that tree's rules even though the binary came from the root.
prettier_cmd=""
if [ -x node_modules/.bin/prettier ]; then
  prettier_cmd="node_modules/.bin/prettier"
elif have npx && npx --no-install prettier --version >/dev/null 2>&1; then
  prettier_cmd="npx"
fi
prettier_warned=0
prettier_write() {
  case "$prettier_cmd" in
    npx) npx --no-install prettier --write --log-level error "$1" ;;
    "")
      # Once per commit, not once per file.
      [ "$prettier_warned" -eq 1 ] && return 0
      prettier_warned=1
      echo "  note: no project-local prettier - nothing formatted; run 'npm ci' (CI checks it as a hard gate)" >&2
      ;;
    *) "$prettier_cmd" --write --log-level error "$1" ;;
  esac
}

# 1) Format staged files in place (Google style), then re-stage.
# quotePath=false: git otherwise renders a non-ASCII path as "\303\274ber", whose leading quote
# defeats every match below - the file would silently skip formatting and the roster check.
staged="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM)"
unstaged="$(git -c core.quotePath=false diff --name-only)"
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # A file with unstaged changes is left alone: formatting it and re-adding would sweep those
  # unstaged edits into the commit. Only what you staged gets committed (aiflow-5n9).
  if printf '%s\n' "$unstaged" | grep -qxF -- "$f"; then
    echo "  note: $f has unstaged changes - not formatted; only its staged version is committed" >&2
    continue
  fi
  case "$f" in
    *.py)  have black && black -q "$f"; have isort && isort -q "$f" ;;
    *.js|*.jsx|*.ts|*.tsx|*.json|*.css|*.md|*.yml|*.yaml) prettier_write "$f" ;;
    *.go)  have gofmt && gofmt -w "$f" ;;
    *.java) have google-java-format && google-java-format -i "$f" ;;
    *.dart) have dart && dart format "$f" >/dev/null 2>&1 ;;
    *.c|*.cc|*.cpp|*.h|*.hpp) have clang-format && clang-format -i --style=Google "$f" ;;
    *.sh)  have shfmt && shfmt -w -i 2 "$f" ;;
  esac
  git add "$f" 2>/dev/null || true
done <<< "$staged"

# 2) Agent roster guard: invalid frontmatter silently drops an agent from Claude Code's roster
# (a command/skill quietly falls back to its body text). CI catches it, but only after a push -
# here it costs a second, so it runs before the slow stack tests below.
# Herestring, not `printf | grep -q`: grep exits on the first match, and once the staged list
# outgrows the pipe buffer printf dies of SIGPIPE, which under `pipefail` reads as "no match" -
# the guard would silently skip on exactly the big commits that need it most.
guard=".github/scripts/check-frontmatter.py"
if [ -f "$guard" ] && grep -q '^\.claude/\(agents\|commands\|skills\)/' <<< "$staged"; then
  py=""
  # --selftest, not `import yaml`: it proves interpreter version, PyYAML AND the guard's own
  # logic in one 0.4s run. A bare import probe passes on Python < 3.9, where the guard then
  # crashes on its PEP-585 annotations and would block the commit as if the roster were broken.
  for c in python3 python; do
    have "$c" && "$c" "$guard" --selftest >/dev/null 2>&1 && { py="$c"; break; }
  done
  if [ -n "$py" ]; then
    # Check the INDEX, not the worktree: `checkout-index` materialises exactly what is about to
    # be committed into a temp tree, so a staged fix passes and a staged break fails, whatever
    # the working copy currently looks like. Cleaned up on every exit path, failures included.
    # Inside .git/ on purpose, and a RELATIVE path: the guard echoes back the paths it was
    # given, and an absolute one comes out in the platform's own spelling (C:/... under
    # Git-Bash), which the prefix-stripping sed below would then fail to match.
    stage_dir=".git/aiflow-precommit-$$"
    mkdir -p "$stage_dir"
    trap 'rm -rf "$stage_dir"' EXIT
    git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM -z \
      -- .claude/agents .claude/commands .claude/skills \
      | xargs -0 -r git checkout-index --prefix="$stage_dir/" --
    # The guard reports the paths it was given, which are inside the temp tree - strip the prefix
    # so the message names the file you actually have to fix.
    out="$("$py" "$guard" "$stage_dir/.claude/agents" "$stage_dir/.claude/commands" \
      "$stage_dir/.claude/skills" 2>&1)"; rc=$?
    printf '%s\n' "$out" | sed "s|$stage_dir/||g" >&2
    rm -rf "$stage_dir"
    trap - EXIT
    [ "$rc" -eq 0 ] \
      || fail "invalid frontmatter somewhere in the agent/command/skill roster (errors above)"
  else
    echo "  note: skipping the frontmatter guard - needs python3/python + PyYAML (pip install pyyaml), or its self-test failed" >&2
  fi
fi

# 3) Bead ids in the ADDED lines: same warning as in commit-msg, for files rather than the
# message. Added lines only — an id already sitting in a file you touched is not this commit's
# problem, and warning about it every time would train you to ignore the warning.
# Looked for next to the hook AND in .githooks/: `core.hooksPath` points at .beads/hooks here,
# where beads installed its hooks but not this library, so the step skipped itself in silence on
# every commit since (enigma2_player-aji). Missing in both, it says so instead of vanishing.
lib=""
for cand in "$(dirname "$0")/lib-bead-ids.sh" \
  "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/lib-bead-ids.sh"; do
  [ -f "$cand" ] && { lib="$cand"; break; }
done
if [ -n "$lib" ]; then
  # shellcheck source=/dev/null
  . "$lib"
  # quotePath=false like every other path-reading call here: a non-ASCII path would otherwise
  # arrive octal-escaped as "\303\274ber" and drag that escaping into the scanned text
  # (aiflow-4cl). Written as the bytes git actually prints, not as the mojibake glyphs it used
  # to show here: those made this comment the only false positive of check-encoding.mjs
  # (enigma2_player-5rk).
  git -c core.quotePath=false diff --cached -U0 | grep '^+' | warn_unknown_bead_ids "staged changes"
else
  echo "  ! no lib-bead-ids.sh next to this hook or in .githooks/ - bead ids NOT checked" >&2
fi

# 4) The two hook trees must not drift apart. The same three hooks are versioned twice -
# .githooks/ is the aiflow template, and whatever core.hooksPath points at is what git actually
# runs - and nothing compared them (enigma2_player-puh). Editing one copy only is invisible: a fix
# in the template changes nothing about the running hook, and a fix in the running copy is
# overwritten by the next `bd hooks install`. Not theory - lib-bead-ids.sh existed in the template
# alone, and the bead-id check above silently did nothing for every commit since
# (enigma2_player-aji).
#
# Two tiers on purpose. If THIS commit touches a hook, drift is a hard stop: that is the moment its
# author can fix it, and the moment the fix would otherwise be half-applied. If it does not, drift
# only warns - a commit elsewhere in the tree must not be held hostage by a divergence somebody
# else introduced, and the warning returns on every commit until it is dealt with. A beads block
# appended back into the running copy (enigma2_player-a3q) surfaces as that warning.
#
# lib-bead-ids.sh is deliberately NOT compared: it belongs to the template alone, and both hooks
# resolve it from there instead of keeping a second copy (aji).
hooks_tmpl="$(git rev-parse --show-toplevel 2>/dev/null)/.githooks"
hooks_run="$(dirname "$0")"
tmpl_abs=""
run_abs=""
[ -d "$hooks_tmpl" ] && tmpl_abs="$(cd "$hooks_tmpl" && pwd)"
[ -d "$hooks_run" ] && run_abs="$(cd "$hooks_run" && pwd)"
if ! have cmp; then
  echo "  ! no cmp - the two hook copies were NOT compared" >&2
elif [ -n "$tmpl_abs" ] && [ -n "$run_abs" ] && [ "$tmpl_abs" != "$run_abs" ]; then
  drift=""
  for h in commit-msg pre-commit pre-push; do
    [ -f "$hooks_tmpl/$h" ] || continue
    # `cmp -s` fails for a missing running copy too - its own defect, and one git reports by
    # simply not running the hook at all.
    cmp -s "$hooks_tmpl/$h" "$hooks_run/$h" || drift="$drift $h"
  done
  if [ -n "$drift" ]; then
    echo "  ! hook copies disagree:$drift" >&2
    echo "      template: $tmpl_abs" >&2
    echo "      running:  $run_abs" >&2
    echo "      copy the intended version over the other - otherwise a fix or a commit is lost" >&2
    # Whether THIS commit touches a hook is asked of git as a pathspec, not matched against the
    # staged list by hand. Two reasons. The paths are a setting (core.hooksPath), so hardcoding
    # `.githooks/` and `.beads/hooks/` here would stop matching the moment somebody moves them -
    # silently, which is the failure this gate exists to catch. And the obvious way to make them
    # relative does not work on Windows: `pwd` says /c/dev/..., `git rev-parse --show-toplevel`
    # says C:/dev/..., so stripping the one from the other leaves the path untouched and nothing
    # ever matches. One call per directory, because a pathspec outside the work tree makes git
    # fail for the whole call and the other directory must still be checked.
    staged_hooks=""
    for d in "$hooks_tmpl" "$hooks_run"; do
      in_d="$(git diff --cached --name-only --diff-filter=ACM -- "$d" 2>/dev/null)"
      staged_hooks="$staged_hooks$in_d"
    done
    if [ -n "$staged_hooks" ]; then
      fail "this commit changes a hook and the two copies disagree (see above)"
    fi
  fi
fi

# 5) Lint + tests by detected stack (best-effort; fails the commit on error).
if [ -f package.json ]; then
  have npx && npx --no-install eslint . >/dev/null 2>&1 || true
  # The manifest is asked about its STRUCTURE, not its text. `grep -q '"test"' package.json` also
  # matches a dependency NAMED test - the npm package exists - and `npm test` without a script
  # exits with "Missing script: test", which this hook would turn into a blocked commit nobody can
  # explain (enigma2_player-nje). Wherever npm exists so does node, and if it does not, the step
  # says so rather than quietly deciding either way.
  if have node; then
    node -e 'process.exit(require("./package.json").scripts?.test ? 0 : 1)' 2>/dev/null \
      && { npm test --silent || fail "npm test failed"; }
  else
    echo "  ! no node - cannot read package.json scripts; unit tests NOT run" >&2
  fi
fi
[ -f pyproject.toml ] || [ -f requirements.txt ] && { have ruff && { ruff check . || fail "ruff failed"; }; have pytest && { pytest -q || fail "pytest failed"; }; }
[ -f go.mod ] && { [ -z "$(gofmt -l .)" ] || fail "gofmt"; have go && { go vet ./... || true; go test ./... || fail "go test failed"; }; }
[ -f pubspec.yaml ] && { have dart && dart analyze >/dev/null 2>&1; have flutter && { flutter test || fail "flutter test failed"; }; }

echo "• pre-commit OK"
# Nothing runs below this line, and nothing may be appended below it. `bd hooks install` installs
# beads' integration by APPENDING, so the active copy of this hook in .beads/hooks/ carried 30
# lines of unreachable code behind this `exit 0` (enigma2_player-a3q), while `bd hooks list`
# reported the hook as "installed (shim 1.0.5)".
#
# The block was removed rather than made reachable. Reaching it gains nothing today: `bd hooks run
# pre-commit` and `bd hooks run pre-push` are no-ops in bd 1.0.5 - probed with writes allowed and
# no remote push, both print nothing, exit 0, and leave every file in .beads/ untouched. What it
# would gain tomorrow is beads writing to the issue DB on every commit and every push, which this
# project deliberately does not do (CLAUDE.md: no commit, no push, no Dolt sync without being
# asked). Beads' own three hooks keep their block and keep working, because there it sits in line
# 2: post-merge, post-checkout, prepare-commit-msg.
#
# If a later `bd hooks install` appends it here again, remove it again - `bd hooks uninstall` is
# the blunt instrument that would take those three working hooks with it.
exit 0
