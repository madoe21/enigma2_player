{
    "model":  "simple",
    "strict":  false,
    "permanentBranches":  [
                              "main",
                              "develop"
                          ],
    "branchTypes":  [
                        "chore/*"
                    ],
    "allowedCreations":  [
                             {
                                 "type":  "\u003cany temporary\u003e",
                                 "from":  [
                                              "develop"
                                          ]
                             },
                             {
                                 "type":  "chore/*",
                                 "from":  [
                                              "develop",
                                              "main"
                                          ]
                             }
                         ],
    "allowedMerges":  [
                          {
                              "from":  "develop",
                              "to":  "main"
                          },
                          {
                              "from":  "main",
                              "to":  "develop"
                          },
                          {
                              "from":  "chore/*",
                              "to":  "develop"
                          },
                          {
                              "from":  "chore/*",
                              "to":  "main"
                          }
                      ],
    "mainRestricted":  null,
    "pullRequests":  {
                         "required":  false
                     },
    "release":  {
                    "auto":  false
                },
    "branchNaming":  "not enforced (temporary branches may use any name)"
}