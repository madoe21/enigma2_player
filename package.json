{
  "name": "enigma2-player-repo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-level toolchain. The site itself lives in site/ (Angular 22, prerendered).",
  "scripts": {
    "check:encoding": "node .github/scripts/check-encoding.mjs .",
    "check:format": "prettier --check .",
    "check:hooks": "bash .github/scripts/check-hook-sync.sh",
    "format": "prettier --write .",
    "test:aiflow": "bats test/aiflow",
    "test:hooks": "bats test/hooks",
    "test:scripts": "node --test \"test/scripts/*.test.mjs\"",
    "test:hooks:mutate": "node test/hooks/mutation-check.mjs"
  },
  "devDependencies": {
    "bats": "1.13.0",
    "prettier": "3.9.10"
  }
}
