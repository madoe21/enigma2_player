/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    /* On, and it stays on. The code already satisfied both strict flags before they
       were set (enigma2_player-b3m): `tsc --strict --noEmit` and a strictTemplates
       build each reported zero errors, so this costs nothing and keeps the next
       `null` or the next mistyped template binding from compiling. Turning either
       one off again is not a formatting choice - it hides errors that are already
       absent today. */
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    /* The template half of `strict` above - without it the compiler type-checks the
       classes and waves the templates through, which is where an Angular typo lives. */
    "strictTemplates": true,
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
